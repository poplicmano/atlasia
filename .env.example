# Required. Use a random 32+ byte value. This encrypts webhook URLs and keys session hashes.
APP_SECRET=replace-with-a-long-random-secret

# First-run administrator. There is no public registration.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=ATLASIA Administrator

# Optional. Used when the app sits behind a proxy and for strict origin checks.
APP_URL=http://localhost:3000

# Optional security and storage settings.
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=2
DATABASE_PATH=./data/atlasia.db
